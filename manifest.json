{
  "manifest_version": 3,
  "name": "Chess Zen Mode",
  "version": "0.1.0",
  "description": "Center the board and hide distractions on Chess.com online games and puzzles. Visual focus tool only.",
  "minimum_chrome_version": "105",
  "permissions": ["storage"],
  "host_permissions": ["https://www.chess.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": [
        "src/lib/settings.js",
        "src/lib/pages.js",
        "src/lib/layout.js",
        "src/lib/stats.js",
        "src/content/content.js"
      ],
      "css": ["src/content/zen.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Chess Zen Mode",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
